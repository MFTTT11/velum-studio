# ============================================================
# VELUM — Environment Configuration Template (NO REAL SECRETS)
# Copy to .env locally (ignored by .gitignore) or set in GitHub Secrets.
# ============================================================

# YouTube OAuth Credentials (Raw JSON or Base64-encoded JSON)
YOUTUBE_CLIENT_SECRETS=
YOUTUBE_TOKEN=

# Optional LLM Providers (Built-in editorial engine operates natively if unset)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional Stock Photography API Keys (Wikimedia Commons + Editorial Plates active by default)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Runtime Tuning
CHANNEL_DEFAULT_LANG=en
AUTOPILOT_TIMEZONE=UTC
AUTOPILOT_DRY_RUN=false
